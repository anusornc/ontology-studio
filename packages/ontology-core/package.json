{
  "name": "@onto/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pure-TypeScript ontology domain model, validation, mutation helpers and OWL/JSON-LD/Turtle serialization.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --out-dir dist --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "tsup": "9.0.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
